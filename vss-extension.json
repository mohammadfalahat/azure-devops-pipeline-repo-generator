{
  "manifestVersion": 1,
  "id": "pipeline-generator",
  "publisher": "mohammad-falahat",
  "version": "0.1.53",
  "name": "Pipeline Generator",
  "description": "Create standard or Nx Monorepo YAML pipelines and classic Komodo release definitions from a branch.",
  "public": false,
  "categories": ["Azure Pipelines", "Azure Repos"],
  "icons": {
    "default": "dist/images/icon.svg"
  },
  "files": [
    { "path": "dist", "addressable": true },
    { "path": "README.md" }
  ],
  "contributions": [
    {
      "id": "pipeline-generator-hub",
      "type": "ms.vss-web.hub",
      "description": "Pipeline Generator hosted inside the Azure Repos experience.",
      "targets": [
        "ms.vss-code-web.code-hub-group"
      ],
      "properties": {
        "name": "Pipeline Generator",
        "order": 90,
        "uri": "dist/index.html"
      }
    },
    {
      "id": "pipeline-generator-dialog",
      "type": "ms.vss-web.control",
      "description": "Pipeline Generator content hosted inside an Azure DevOps dialog.",
      "targets": [],
      "properties": {
        "uri": "dist/index.html"
      }
    },
    {
      "id": "generate-pipeline-action",
      "type": "ms.vss-web.action",
      "targets": [
        "ms.vss-code-web.git-branches-menu",
        "ms.vss-code-web.branches-menu",
        "ms.vss-code-web.git-branches-tree-menu",
        "ms.vss-code-web.git-branches-toolbar-menu",
        "ms.vss-code-web.repository-branches-menu",
        "ms.vss-code-web.repository-branches-tree-menu",
        "ms.vss-code-web.repository-branches-toolbar-menu",
        "ms.vss-code-web.repository-branches-list-menu",
        "ms.vss-code-web.repository-branches-list-toolbar-menu",
        "ms.vss-code-web.vc-branches-menu",
        "ms.vss-code-web.vc-branches-tree-menu",
        "ms.vss-code-web.vc-branches-toolbar-menu"
      ],
      "properties": {
        "text": "Generate pipeline",
        "title": "Generate pipeline for this branch",
        "icon": "dist/images/icon.svg",
        "uri": "dist/menu-action.html",
        "registeredObjectId": "generate-pipeline-action"
      }
    },
    {
      "id": "generate-monorepo-action",
      "type": "ms.vss-web.action",
      "targets": [
        "ms.vss-code-web.git-branches-menu",
        "ms.vss-code-web.branches-menu",
        "ms.vss-code-web.git-branches-tree-menu",
        "ms.vss-code-web.git-branches-toolbar-menu",
        "ms.vss-code-web.repository-branches-menu",
        "ms.vss-code-web.repository-branches-tree-menu",
        "ms.vss-code-web.repository-branches-toolbar-menu",
        "ms.vss-code-web.repository-branches-list-menu",
        "ms.vss-code-web.repository-branches-list-toolbar-menu",
        "ms.vss-code-web.vc-branches-menu",
        "ms.vss-code-web.vc-branches-tree-menu",
        "ms.vss-code-web.vc-branches-toolbar-menu"
      ],
      "properties": {
        "text": "Generate MonoRepo",
        "title": "Generate one MR pipeline and release for this Nx monorepo branch",
        "icon": "dist/images/icon.svg",
        "uri": "dist/menu-action.html",
        "registeredObjectId": "generate-monorepo-action"
      }
    }
  ],
  "targets": [
    { "id": "Microsoft.VisualStudio.Services.Cloud" },
    { "id": "Microsoft.TeamFoundation.Server", "version": "[16.0,20.0)" }
  ],
  "scopes": ["vso.code", "vso.code_manage", "vso.project", "vso.build", "vso.build_execute", "vso.release", "vso.release_manage", "vso.agentpools", "vso.serviceendpoint", "vso.variablegroups_read"],
  "links": {
    "getstarted": {
      "uri": "https://learn.microsoft.com/azure/devops/extend/get-started/node"
    },
    "repository": {
      "uri": "https://azure.buluttakin.com/tfs/_git/pipeline-generator"
    },
    "support": {
      "uri": "https://azure.buluttakin.com/tfs/"
    }
  },
  "content": {
    "details": {
      "path": "README.md"
    }
  },
  "branding": {
    "color": "#0078D4",
    "theme": "dark"
  }
}
